local function New(cls, props, p, rad)
    local obj = Instance.new(cls)
    for k, v in pairs(props or {}) do obj[k] = v end
    if rad then Instance.new("UICorner", obj).CornerRadius = UDim.new(0, rad) end
    if p then obj.Parent = p end
    return obj
end

local function Tween(instance, props, dur, style, dir)
    local tw = TweenService:Create(
        instance,
        TweenInfo.new(dur or 0.22, style or Enum.EasingStyle.Quart, dir or Enum.EasingDirection.Out),
        props
    )
    tw:Play()
    return tw
end

