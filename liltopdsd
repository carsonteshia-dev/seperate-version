-- 1. Hook __index on InputObject (covers all scripts reading input.KeyCode)
local oldIndex
oldIndex = hookmetamethod(game, "__index", function(self, key)
    if typeof(self) == "Instance" and self:IsA("InputObject") then
        if key == "KeyCode" then
            local realKey = oldIndex(self, key)
            if realKey == TARGET_KEY and areFlagsApplied() then
                return Enum.KeyCode.Unknown
            end
        end
    end
    return oldIndex(self, key)
end)

-- 2. Hook __namecall (covers IsKeyDown, GetKeysPressed, IsGamepadButtonDown)
local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    local args = {...}

    if self == UserInputService and areFlagsApplied() then
        if (method == "IsKeyDown" or method == "IsGamepadButtonDown") and args[1] == TARGET_KEY then
            return false
        elseif method == "GetKeysPressed" or method == "GetGamepadState" then
            local keys = oldNamecall(self, ...)
            local filtered = {}
            for _, inputObj in ipairs(keys) do
                if inputObj.KeyCode ~= TARGET_KEY then
                    table.insert(filtered, inputObj)
                end
            end
            return filtered
        end
    end

    return oldNamecall(self, ...)
end)

-- 3. Intercept existing & future signal connections on InputBegan, InputChanged, InputEnded
if getconnections then
    local function patchSignals(signal)
        for _, conn in pairs(getconnections(signal)) do
            local fn = conn.Function
            if fn then
                conn:Disable()
                signal:Connect(function(input, gp)
                    if areFlagsApplied() and input.KeyCode == TARGET_KEY then
                        return -- drop event completely
                    end
                    fn(input, gp)
                end)
            end
        end
    end

    patchSignals(UserInputService.InputBegan)
    patchSignals(UserInputService.InputChanged)
    patchSignals(UserInputService.InputEnded)
end

