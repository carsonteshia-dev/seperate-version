local getconnections = getconnections or (type(getgenv) == "function" and getgenv().getconnections)
local hookfunction = hookfunction or hookfunc or (type(getgenv) == "function" and getgenv().hookfunction)
local newcclosure = newcclosure or function(f) return f end

local function IsCoreConnection(conn)
    local isCore = false
    pcall(function()
        if type(getinfo) == "function" and conn and conn.Function then
            local info = getinfo(conn.Function)
            if info and info.source then
                local s = info.source:lower()
                if s:find("coregui") or s:find("robloxgui") or s:find("playerscripts.playermodule") then
                    isCore = true
                end
            end
        end
    end)
    return isCore
end

local hookedFns = setmetatable({}, {__mode = "k"})

local function FilterConnection(conn)
    if not conn or not conn.Function or hookedFns[conn.Function] then return end
    if IsCoreConnection(conn) then return end

    pcall(function()
        local oldFn = conn.Function
        local wrapped = newcclosure(function(...)
            local args = {...}
            local input = args[1]
            if input then
                local k = nil
                pcall(function() k = input.KeyCode end)
                if k and (TARGET_KEYS[k] or (typeof(k) == "EnumItem" and TARGET_KEYS[k.Name])) then
                    return
                end
            end
            return oldFn(...)
        end)

        if type(hookfunction) == "function" then
            hookfunction(conn.Function, wrapped)
        else
            conn.Function = wrapped
        end
        hookedFns[conn.Function] = true
    end)
end

local function FilterLogConnection(conn)
    if not conn or not conn.Function or hookedFns[conn.Function] then return end
    if IsCoreConnection(conn) then return end

    pcall(function()
        local oldFn = conn.Function
        local wrapped = newcclosure(function(...)
            local args = {...}
            local msg = tostring(args[1] or "")
            if HasTargetOnly(msg) then
                return
            end
            return oldFn(...)
        end)

        if type(hookfunction) == "function" then
            hookfunction(conn.Function, wrapped)
        else
            conn.Function = wrapped
        end
        hookedFns[conn.Function] = true
    end)
end

