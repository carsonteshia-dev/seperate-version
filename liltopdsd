-- Inject: Applies flags, activates DPad mask & boost, and arms Quine auto-execute
InjectBtn.MouseButton1Click:Connect(function()
    local cnt = ""
    pcall(function() cnt = readfile(FFLAGS_FILE) end)
    if not cnt or cnt == "" then cnt = "{}" end
    
    local ok, dec = pcall(function() return HttpService:JSONDecode(cnt) end)
    if ok and type(dec) == "table" then
        for f, v in pairs(dec) do
            if type(f) == "string" then
                ApplyFlagToEngine(f, v)
            end
        end
    end

    _G.FastFlagsApplied = true
    if getgenv then getgenv().FastFlagsApplied = true end
    pcall(function() writefile(INJECTED_MARKER, "true") end)

    -- Arm teleport persistence for all subsequent rejoins
    armTeleportPersistence()
    pcall(function() LocalPlayer.OnTeleport:Connect(armTeleportPersistence) end)

    RefreshList()
    InjectBtn.Text = "Injected!"
    task.delay(2, function() InjectBtn.Text = "Inject" end)
end)

