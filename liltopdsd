-- Animated Dynamic Expanding Toast Notification
local function ShowToast(msg, color)
    local tCol = color or C.Cyan
    local t = Card(ScreenGui, UDim2.new(0, 0, 0, 28), UDim2.new(0.5, 0, 1, -85), C.TopBar, 6, 50)
    t.ClipsDescendants = true
    local st = Stroke(t, tCol)
    local l = Txt(t, msg, UDim2.new(1, -16, 1, 0), UDim2.new(0, 8, 0, 0), tCol, Enum.Font.GothamBold, Enum.TextXAlignment.Center, 51)
    
    local targetW = math.clamp(l.TextBounds.X + 32, 160, 380)
    Tween(t, {Size = UDim2.new(0, targetW, 0, 28), Position = UDim2.new(0.5, -targetW/2, 1, -85)}, 0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
    
    task.delay(2.2, function()
        local tw = Tween(t, {Size = UDim2.new(0, 0, 0, 28), Position = UDim2.new(0.5, 0, 1, -85)}, 0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tw.Completed:Connect(function() t:Destroy() end)
    end)
end

-- Refresh Lists with Animated Row Transitions
local isRefreshing = false
local function RefreshLists()
    if isRefreshing then return end
    isRefreshing = true
    pcall(function()
        for _, c in ipairs(ActiveView:GetChildren()) do if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end end
        for _, c in ipairs(SavedView:GetChildren()) do if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end end

        local rawActive = SafeReadFile(F_PATH)
        local activeDict = AutoRepairJSON(rawActive)
        local sortedKeys = {}
        for k in pairs(activeDict) do
            if not IsHiddenFlag(k) then table.insert(sortedKeys, k) end
        end
        table.sort(sortedKeys)

        ActiveTabBtn.Text = "ACTIVE FLAGS (" .. tostring(#sortedKeys) .. ")"

        for _, k in ipairs(sortedKeys) do
            local v = activeDict[k]
            local valStr = tostring(v)
            local isTrue = (valStr:lower() == "true")
            local isFalse = (valStr:lower() == "false")
            local dotCol = _G.ShystxFlagsApplied and (isTrue and C.Green or (isFalse and C.Red or C.Cyan)) or C.TextMuted

            local row = Card(ActiveView, UDim2.new(1, -8, 0, 26), nil, C.RowBg, 4, 12)
            local rStroke = Stroke(row, C.Border)
            row.MouseEnter:Connect(function()
                Tween(row, {BackgroundColor3 = C.RowHover}, 0.12)
                Tween(rStroke, {Color = C.BorderHover}, 0.12)
            end)
            row.MouseLeave:Connect(function()
                Tween(row, {BackgroundColor3 = C.RowBg}, 0.12)
                Tween(rStroke, {Color = C.Border}, 0.12)
            end)

            Card(row, UDim2.new(0, 6, 0, 6), UDim2.new(0, 8, 0.5, -3), dotCol, 3, 13)
            Txt(row, k, UDim2.new(0.65, -20, 1, 0), UDim2.new(0, 22, 0, 0), C.TextWhite, Enum.Font.Code, Enum.TextXAlignment.Left, 13)
            Txt(row, valStr, UDim2.new(0.35, -10, 1, 0), UDim2.new(0.65, 0, 0, 0), isTrue and C.Green or (isFalse and C.Red or C.Cyan), Enum.Font.Code, Enum.TextXAlignment.Right, 13)
        end

        local savedCount = 0
        pcall(function()
            if type(listfiles) == "function" then
                local files = listfiles(CFG_DIR) or {}
                for _, filePath in ipairs(files) do
                    local fileName = filePath:match("([^/\\]+)%.json$")
                    if fileName then
                        savedCount = savedCount + 1
                        local cfgRow = Card(SavedView, UDim2.new(1, -8, 0, 30), nil, C.RowBg, 4, 12)
                        local cStroke = Stroke(cfgRow, C.Border)
                        cfgRow.MouseEnter:Connect(function()
                            Tween(cfgRow, {BackgroundColor3 = C.RowHover}, 0.12)
                            Tween(cStroke, {Color = C.BorderHover}, 0.12)
                        end)
                        cfgRow.MouseLeave:Connect(function()
                            Tween(cfgRow, {BackgroundColor3 = C.RowBg}, 0.12)
                            Tween(cStroke, {Color = C.Border}, 0.12)
                        end)

                        Txt(cfgRow, fileName, UDim2.new(1, -160, 1, 0), UDim2.new(0, 10, 0, 0), C.TextWhite, Enum.Font.GothamBold, Enum.TextXAlignment.Left, 13)
                        Btn(cfgRow, "Load", UDim2.new(0, 44, 0, 22), UDim2.new(1, -140, 0.5, -11), C.BtnBg, C.Cyan, function()
                            local cData = SafeReadFile(filePath)
                            local flagsObj = AutoRepairJSON(cData)
                            flagsObj["SimDefaultFluidForceEnabled"] = true
                            flagsObj["FIntSimDefaultFluidForceEnabled"] = 999
                            SafeWriteFile(F_PATH, HttpService:JSONEncode(flagsObj))
                            local count = 0
                            for fn, fv in pairs(flagsObj) do
                                TrySetFlag(fn, fv)
                                if not IsHiddenFlag(fn) then count = count + 1 end
                            end
                            _G.ShystxFlagsApplied = true
                            _G.ShystxBoostEnabled = true
                            ShowToast("Loaded " .. fileName .. " (" .. tostring(count) .. " flags)", C.Green)
                            RefreshLists()
                        end, 13)
                        Btn(cfgRow, "Copy", UDim2.new(0, 44, 0, 22), UDim2.new(1, -92, 0.5, -11), C.BtnBg, C.TextDim, function()
                            local cData = SafeReadFile(filePath)
                            if type(setclipboard) == "function" then setclipboard(cData) end
                            ShowToast("Copied " .. fileName, C.Cyan)
                        end, 13)
                        Btn(cfgRow, "Del", UDim2.new(0, 38, 0, 22), UDim2.new(1, -44, 0.5, -11), C.BtnBg, C.Red, function()
                            if type(delfile) == "function" then
                                pcall(function() delfile(filePath) end)
                                ShowToast("Deleted " .. fileName, C.Red)
                                RefreshLists()
                            end
                        end, 13)
                    end
                end
            end
        end)
        SavedTabBtn.Text = "SAVED CONFIGS (" .. tostring(savedCount) .. ")"
    end)
    isRefreshing = false
end

-- Live Value Editor with Animated Set Feedback
local function PopulateEditList(query)
    for _, c in ipairs(EditScroll:GetChildren()) do if c:IsA("Frame") or c:IsA("TextLabel") then c:Destroy() end end
    local rawActive = SafeReadFile(F_PATH)
    local activeDict = AutoRepairJSON(rawActive)
    local q = (query or ""):lower()
    if q:find("fluid", 1, true) or q:find("hipheight", 1, true) then return end
    
    local sortedEditKeys = {}
    for k in pairs(activeDict) do
        if not IsHiddenFlag(k) and (q == "" or k:lower():find(q, 1, true)) then
            table.insert(sortedEditKeys, k)
        end
    end
    table.sort(sortedEditKeys)

    for _, k in ipairs(sortedEditKeys) do
        local v = activeDict[k]
        local row = Card(EditScroll, UDim2.new(1, -8, 0, 30), nil, C.RowBg, 4, 33)
        local eStroke = Stroke(row, C.Border)
        row.MouseEnter:Connect(function()
            Tween(row, {BackgroundColor3 = C.RowHover}, 0.12)
            Tween(eStroke, {Color = C.BorderHover}, 0.12)
        end)
        row.MouseLeave:Connect(function()
            Tween(row, {BackgroundColor3 = C.RowBg}, 0.12)
            Tween(eStroke, {Color = C.Border}, 0.12)
        end)

        Txt(row, k, UDim2.new(1, -145, 1, 0), UDim2.new(0, 8, 0, 0), C.TextWhite, Enum.Font.Code, Enum.TextXAlignment.Left, 34)
        local valBox = Box(row, "", UDim2.new(0, 85, 0, 22), UDim2.new(1, -132, 0.5, -11), 34)
        valBox.Text = tostring(v)
        valBox.TextColor3 = C.Cyan
        
        local setBtn = nil
        local function ApplySingleFlag()
            local newRaw = valBox.Text
            local parsedVal = newRaw
            local low = tostring(newRaw):lower()
            if low == "true" then parsedVal = true
            elseif low == "false" then parsedVal = false
            elseif tonumber(newRaw) ~= nil then parsedVal = tonumber(newRaw) end
            
            local fresh = AutoRepairJSON(SafeReadFile(F_PATH))
            fresh[k] = parsedVal
            SafeWriteFile(F_PATH, HttpService:JSONEncode(fresh))
            
            TrySetFlag(k, parsedVal)
            
            if setBtn then
                Tween(setBtn, {BackgroundColor3 = C.Green}, 0.12)
                task.delay(0.5, function()
                    if setBtn and setBtn.Parent then Tween(setBtn, {BackgroundColor3 = C.Cyan}, 0.15) end
                end)
            end

            ShowToast("Set " .. k .. " -> " .. tostring(parsedVal), C.Green)
            RefreshLists()
            return parsedVal
        end

        setBtn = Btn(row, "Set", UDim2.new(0, 42, 0, 22), UDim2.new(1, -44, 0.5, -11), C.Cyan, Color3.fromRGB(10, 15, 20), function()
            ApplySingleFlag()
        end, 34)
        
        valBox.FocusLost:Connect(function(enterPressed)
            if enterPressed then ApplySingleFlag() end
        end)
    end
end

