local setfflagFunc = setfflag or set_fflag or (getgenv and getgenv().setfflag) or setflag or (getgenv and getgenv().setflag)

local function UltraCleanJSON(str)
    if not str or str == "" then return "{}" end
    str = str:gsub("/%*.-%*/", ""):gsub("//[^\r\n]*", "")
    return str
end

local function ExecuteInjectionLogic(rawText, shouldMerge)
    local cleanedRaw = UltraCleanJSON(rawText)
    local success, decoded = pcall(function() return HttpService:JSONDecode(cleanedRaw) end)
    
    if success and type(decoded) == "table" then
        local finalTable = decoded

        -- Non-destructive merge logic
        if shouldMerge then
            local existingRaw = ""
            pcall(function() existingRaw = readfile(FFLAGS_FILE) end)
            local okEx, existingDec = pcall(function() return HttpService:JSONDecode(existingRaw) end)
            if okEx and type(existingDec) == "table" then
                for k, v in pairs(decoded) do
                    existingDec[k] = v
                end
                finalTable = existingDec
            end
        end

        local encodedData = HttpService:JSONEncode(finalTable)
        if writefile then
            pcall(function()
                writefile(FFLAGS_FILE, encodedData)
            end)
        end
        
        local successCount = 0
        local errorCount = 0
        
        for flagName, val in pairs(finalTable) do
            local cleanName = flagName:gsub("DFInt", ""):gsub("DFFlag", ""):gsub("FFlag", ""):gsub("FInt", ""):gsub("DFString", ""):gsub("FString", "")
            local applied = false
            
            if setfflagFunc then
                local ok1 = pcall(function()
                    setfflagFunc(flagName, tostring(val))
                end)
                if ok1 then
                    applied = true
                else
                    local ok2 = pcall(function()
                        setfflagFunc(cleanName, tostring(val))
                    end)
                    if ok2 then applied = true end
                end
            end
            
            if flagName:lower():find("targetfps") and setfpscap then
                local fpsOk = pcall(function()
                    setfpscap(tonumber(val) or 9999)
                end)
                if fpsOk then applied = true end
            end
            
            if applied then
                successCount = successCount + 1
            else
                errorCount = errorCount + 1
            end
        end
        
        return true, successCount, errorCount
    else
        return false, 0, 0, decoded
    end
end

