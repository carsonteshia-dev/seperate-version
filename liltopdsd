-- Live Lists Synchronization
local currentSearchQuery = ""
local function RefreshLists()
    for _, x in ipairs(FlagScroll:GetChildren()) do if x:IsA("Frame") then x:Destroy() end end
    for _, x in ipairs(ConfigScroll:GetChildren()) do if x:IsA("Frame") then x:Destroy() end end

    local cnt = SafeReadFile(F_PATH)
    local dec = AutoRepairJSON(cnt)
    local activeCount = 0
    local filter = currentSearchQuery:lower():gsub(" ", "")

    if type(dec) == "table" then
        for k, v in pairs(dec) do
            activeCount = activeCount + 1
            if filter == "" or k:lower():find(filter, 1, true) then
                local isVerified = VerifyFlagStatus(k)
                local R = New("Frame", {Size = UDim2.new(1, -6, 0, 32), BackgroundColor3 = C.CardBg, BorderSizePixel = 0, ZIndex = 6}, FlagScroll, 6)
                
                -- Status Indicator Dot
                New("Frame", {Size = UDim2.new(0, 6, 0, 6), Position = UDim2.new(0, 10, 0.5, -3), BackgroundColor3 = isVerified and C.Green or C.Red, BorderSizePixel = 0, ZIndex = 7}, R, 3)
                
                -- Flag Name (Safely Truncated)
                New("TextLabel", {
                    Size = UDim2.new(1, -215, 1, 0),
                    Position = UDim2.new(0, 22, 0, 0),
                    BackgroundTransparency = 1,
                    Text = k,
                    Font = Enum.Font.Code,
                    TextSize = 11,
                    TextColor3 = C.TxtDark,
                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClipsDescendants = true,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 7
                }, R)

                -- Inline Right Control Dock (Value, SET, DEL)
                local dock = New("Frame", {Size = UDim2.new(0, 190, 1, 0), Position = UDim2.new(1, -192, 0, 0), BackgroundTransparency = 1, ZIndex = 8}, R)
                local valBox = New("TextBox", {Size = UDim2.new(0, 72, 0, 22), Position = UDim2.new(0, 0, 0.5, -11), BackgroundColor3 = C.EditorBg, Text = tostring(v), Font = Enum.Font.Code, TextSize = 11, TextColor3 = C.Blue, ZIndex = 9}, dock, 4)
                New("UIStroke", {Thickness = 1, Color = C.Border}, valBox)

                local setBtn = New("TextButton", {Size = UDim2.new(0, 52, 0, 22), Position = UDim2.new(0, 77, 0.5, -11), BackgroundColor3 = C.Green, BorderSizePixel = 0, Text = "SET", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.TxtWhite, ZIndex = 9}, dock, 4)
                local delBtn = New("TextButton", {Size = UDim2.new(0, 52, 0, 22), Position = UDim2.new(0, 134, 0.5, -11), BackgroundColor3 = C.Red, BorderSizePixel = 0, Text = "DEL", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.TxtWhite, ZIndex = 9}, dock, 4)

                local function ApplyVal()
                    local newText = valBox.Text:gsub('^%s*(.-)%s*$', '%1')
                    local parsedVal = tonumber(newText)
                    if parsedVal == nil then
                        if newText:lower() == "true" then parsedVal = true
                        elseif newText:lower() == "false" then parsedVal = false
                        else parsedVal = newText end
                    end
                    dec[k] = parsedVal
                    SafeWriteFile(F_PATH, HttpService:JSONEncode(dec))
                    TrySetFlag(k, parsedVal)
                    return parsedVal
                end

                valBox.FocusLost:Connect(function() ApplyVal() RefreshLists() end)
                setBtn.MouseButton1Click:Connect(function()
                    local finalVal = ApplyVal()
                    setBtn.Text = "OK!"
                    ShowToast("Set " .. k .. " = " .. tostring(finalVal), C.Green)
                    task.delay(0.9, function() pcall(function() setBtn.Text = "SET" end) end)
                    RefreshLists()
                end)

                delBtn.MouseButton1Click:Connect(function()
                    dec[k] = nil
                    SafeWriteFile(F_PATH, HttpService:JSONEncode(dec))
                    R:Destroy()
                    ShowToast("Deleted " .. k, C.Red)
                    RefreshLists()
                end)
            end
        end
    end
    TabActiveBtn.Text = "Active Flags (" .. tostring(activeCount) .. ")"

    -- Merge configs from disk and memory table
    local mergedConfigs = {}
    if type(_G.ShystxSavedConfigs) == "table" then
        for k, v in pairs(_G.ShystxSavedConfigs) do mergedConfigs[k] = v end
    end
    local cfgCnt = SafeReadFile(CONFIGS_PATH)
    local ok, diskConfigs = pcall(function() return HttpService:JSONDecode(cfgCnt) end)
    if ok and type(diskConfigs) == "table" then
        for k, v in pairs(diskConfigs) do mergedConfigs[k] = v end
    end

    local configCount = 0
    for cfgName, flagsObj in pairs(mergedConfigs) do
        if type(flagsObj) == "table" then
            configCount = configCount + 1
            if filter == "" or cfgName:lower():find(filter, 1, true) then
                local flagNum = 0
                for _ in pairs(flagsObj) do flagNum = flagNum + 1 end

                local R = New("Frame", {Size = UDim2.new(1, -6, 0, 36), BackgroundColor3 = C.CardBg, BorderSizePixel = 0, ZIndex = 6}, ConfigScroll, 6)
                New("TextLabel", {Size = UDim2.new(1, -210, 1, 0), Position = UDim2.new(0, 12, 0, 0), BackgroundTransparency = 1, Text = cfgName .. " (" .. tostring(flagNum) .. " flags)", Font = Enum.Font.GothamBold, TextSize = 11, TextColor3 = C.TxtDark, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 7}, R)

                local LoadBtn = New("TextButton", {Size = UDim2.new(0, 56, 0, 24), Position = UDim2.new(1, -180, 0.5, -12), BackgroundColor3 = C.Blue, BorderSizePixel = 0, Text = "Load", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.TxtWhite, ZIndex = 7}, R, 4)
                local CopyBtn = New("TextButton", {Size = UDim2.new(0, 56, 0, 24), Position = UDim2.new(1, -120, 0.5, -12), BackgroundColor3 = C.BtnBg, BorderSizePixel = 0, Text = "Copy", Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = C.TxtDark, ZIndex = 7}, R, 4)
                local DelBtn = New("TextButton", {Size = UDim2.new(0, 56, 0, 24), Position = UDim2.new(1, -60, 0.5, -12), BackgroundColor3 = C.BtnBg, BorderSizePixel = 0, Text = "Delete", Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = C.Red, ZIndex = 7}, R, 4)

                LoadBtn.MouseButton1Click:Connect(function()
                    SafeWriteFile(F_PATH, HttpService:JSONEncode(flagsObj))
                    for fName, val in pairs(flagsObj) do TrySetFlag(fName, val) end
                    ShowToast("Loaded config '" .. cfgName .. "' (" .. tostring(flagNum) .. " flags)", C.Green)
                    RefreshLists()
                end)

                CopyBtn.MouseButton1Click:Connect(function()
                    if type(setclipboard) == "function" then
                        pcall(function() setclipboard(HttpService:JSONEncode(flagsObj)) end)
                        ShowToast("Copied '" .. cfgName .. "' JSON to clipboard", C.Blue)
                    end
                end)

                DelBtn.MouseButton1Click:Connect(function()
                    mergedConfigs[cfgName] = nil
                    _G.ShystxSavedConfigs[cfgName] = nil
                    SafeWriteFile(CONFIGS_PATH, HttpService:JSONEncode(mergedConfigs))
                    ShowToast("Deleted config '" .. cfgName .. "'", C.Red)
                    R:Destroy()
                    RefreshLists()
                end)
            end
        end
    end
    TabSavedBtn.Text = "Named Configs (" .. tostring(configCount) .. ")"

    FlagScroll.CanvasSize = UDim2.new(0, 0, 0, FLayout.AbsoluteContentSize.Y + 12)
    ConfigScroll.CanvasSize = UDim2.new(0, 0, 0, CLayout.AbsoluteContentSize.Y + 12)
end

