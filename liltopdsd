-- Strictly Non-Stacking Jump Engine
local lastJmp = 0
local charConns = {}
local hasBoostedThisJump = false

local function cleanupChar()
    for _, c in ipairs(charConns) do
        if c then c:Disconnect() end
    end
    charConns = {}
    hasBoostedThisJump = false
end

local function hookChar(char)
    if not char then return end
    cleanupChar()

    local hum = char:WaitForChild("Humanoid", 5)
    local hrp = char:WaitForChild("HumanoidRootPart", 5)
    if not hum or not hrp then return end

    local boostReady = true
    local wasLocked = (UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter)

    table.insert(charConns, RunService.RenderStepped:Connect(function()
        local isLocked = (UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter)
        if wasLocked and not isLocked then boostReady = true end
        wasLocked = isLocked
    end))

    local function doJump()
        if not hrp or not hrp.Parent then return end
        if hasBoostedThisJump then return end
        hasBoostedThisJump = true

        local now = tick()
        if (now - lastJmp) < 0.3 then return end
        lastJmp = now

        local isBack = false
        local cam = workspace.CurrentCamera
        if cam then
            local camL = cam.CFrame.LookVector
            local flatCam = Vector3.new(camL.X, 0, camL.Z)
            local move = hum.MoveDirection
            local flatM = Vector3.new(move.X, 0, move.Z)
            if flatCam.Magnitude > 0.05 and flatM.Magnitude > 0.05 then
                if flatM.Unit:Dot(flatCam.Unit) < -0.3 then isBack = true end
            end
        end
        if UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down) then
            isBack = true
        end

        local isShiftUnshift = (boostReady or isBack)
        local forceToAdd = BOOST_FORCE_REGULAR

        if isShiftUnshift then
            if shiftBoostEnabled then
                forceToAdd = BOOST_FORCE_STACK
            else
                forceToAdd = BOOST_FORCE_REGULAR
            end
            boostReady = false
        end

        task.delay(BOOST_DELAY, function()
            if hrp and hrp.Parent then
                hrp.AssemblyLinearVelocity = Vector3.new(
                    hrp.AssemblyLinearVelocity.X,
                    hrp.AssemblyLinearVelocity.Y + forceToAdd,
                    hrp.AssemblyLinearVelocity.Z
                )
            end
        end)
    end

    table.insert(charConns, hum.StateChanged:Connect(function(_, ns)
        if ns == Enum.HumanoidStateType.Landed then
            hasBoostedThisJump = false
            boostReady = true
        elseif ns == Enum.HumanoidStateType.Jumping then
            doJump()
        end
    end))

    table.insert(charConns, hum.Jumping:Connect(function(a) if a then doJump() end end))
end

if LocalPlayer.Character then hookChar(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(hookChar)
