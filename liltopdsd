local function ExitUI()
    if pConn then pcall(function() pConn:Disconnect() end) end
    local tw = Tween(UiScale, {Scale = 0.01}, 0.25, Enum.EasingStyle.Quart)
    tw.Completed:Connect(function() pcall(function() ScreenGui:Destroy() end) end)
end
WipeBtn.MouseButton1Click:Connect(ExitUI)
ClsBtn.MouseButton1Click:Connect(ExitUI)
MinBtn.MouseButton1Click:Connect(function()
    Main.Visible = not Main.Visible
    if not Main.Visible then ImportPanel.Visible, SaveConfigPanel.Visible, EditPanel.Visible = false, false, false end
end)

-- Window Drag Engine
local drag, dInput, dStart, sPos = false, nil, nil, nil
TopBar.InputBegan:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseButton1 or inp.UserInputType == Enum.UserInputType.Touch then
        drag, dStart, sPos = true, inp.Position, Main.Position
        inp.Changed:Connect(function() if inp.UserInputState == Enum.UserInputState.End then drag = false end end)
    end
end)
TopBar.InputChanged:Connect(function(inp)
    if inp.UserInputType == Enum.UserInputType.MouseMovement or inp.UserInputType == Enum.UserInputType.Touch then dInput = inp end
end)
UserInputService.InputChanged:Connect(function(inp)
    if inp == dInput and drag then
        local delta = inp.Position - dStart
        Main.Position = UDim2.new(sPos.X.Scale, sPos.X.Offset + (delta.X / math.max(UiScale.Scale, 0.01)), sPos.Y.Scale, sPos.Y.Offset + (delta.Y / math.max(UiScale.Scale, 0.01))) 
    end
end)

RefreshLists()
