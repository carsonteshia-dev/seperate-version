local function PopulateEditList(query)
    for _, x in ipairs(EditScroll:GetChildren()) do if x:IsA("Frame") then x:Destroy() end end
    local cnt = SafeReadFile(F_PATH)
    local dec = AutoRepairJSON(cnt)
    local filter = (query or ""):lower():gsub(" ", "")

    if type(dec) == "table" then
        for k, v in pairs(dec) do
            if not k:lower():find("fluidforceenabled") and (filter == "" or k:lower():find(filter, 1, true)) then
                local row = Instance.new("Frame", EditScroll)
                row.Size = UDim2.new(1, -8, 0, 30)
                row.BackgroundColor3 = C.CBoxBg
                row.BorderSizePixel = 0
                row.ZIndex = 11
                Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

                local nameLbl = Instance.new("TextLabel", row)
                nameLbl.Size = UDim2.new(1, -165, 1, 0)
                nameLbl.Position = UDim2.new(0, 10, 0, 0)
                nameLbl.BackgroundTransparency = 1
                nameLbl.Text = k
                nameLbl.Font = Enum.Font.Code
                nameLbl.TextSize = 11
                nameLbl.TextColor3 = C.TxtDark
                nameLbl.TextXAlignment = Enum.TextXAlignment.Left
                nameLbl.ZIndex = 11

                local valBox = Instance.new("TextBox", row)
                valBox.Size = UDim2.new(0, 80, 0, 22)
                valBox.Position = UDim2.new(1, -150, 0.5, -11)
                valBox.BackgroundColor3 = C.EditorBg
                valBox.Text = tostring(v)
                valBox.Font = Enum.Font.Code
                valBox.TextSize = 11
                valBox.TextColor3 = C.Blue
                valBox.ZIndex = 11
                Instance.new("UICorner", valBox).CornerRadius = UDim.new(0, 4)

                valBox.FocusLost:Connect(function()
                    local newText = valBox.Text:gsub('^%s*(.-)%s*$', '%1')
                    local num = tonumber(newText)
                    if num ~= nil then dec[k] = num
                    elseif newText:lower() == "true" then dec[k] = true
                    elseif newText:lower() == "false" then dec[k] = false
                    else dec[k] = newText end

                    SafeWriteFile(F_PATH, HttpService:JSONEncode(dec))
                    RefreshLists()
                end)

                local del = Instance.new("TextButton", row)
                del.Size = UDim2.new(0, 50, 0, 22)
                del.Position = UDim2.new(1, -60, 0.5, -11)
                del.BackgroundColor3 = C.BtnBg
                del.BorderSizePixel = 0
                del.Text = "Delete"
                del.Font = Enum.Font.GothamMedium
                del.TextSize = 10
                del.TextColor3 = C.Red
                del.ZIndex = 11
                Instance.new("UICorner", del).CornerRadius = UDim.new(0, 4)

                del.MouseButton1Click:Connect(function()
                    dec[k] = nil
                    SafeWriteFile(F_PATH, HttpService:JSONEncode(dec))
                    row:Destroy()
                    RefreshLists()
                end)
            end
        end
    end
    EditScroll.CanvasSize = UDim2.new(0, 0, 0, ELayout.AbsoluteContentSize.Y + 10)
end

