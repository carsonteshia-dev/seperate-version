    for _, x in ipairs(FlagScroll:GetChildren()) do if x:IsA("Frame") then x:Destroy() end end
    for _, x in ipairs(ConfigScroll:GetChildren()) do if x:IsA("Frame") then x:Destroy() end end

    local cnt = SafeReadFile(F_PATH)
    local dec = AutoRepairJSON(cnt)
    local flagCount = 0

    if type(dec) == "table" then
        for k, v in pairs(dec) do
            if not IsHiddenFlag(k) then
                flagCount = flagCount + 1
                local row = New("Frame", {Size = UDim2.new(1, -6, 0, 34), BackgroundColor3 = C.CardBg, BorderSizePixel = 0, ZIndex = 6}, FlagScroll, 6)
