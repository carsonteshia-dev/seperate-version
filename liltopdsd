-- Animated Modals Builder with Pop-In and Dismiss Tweens
local function MakeModal(w, h, titleText, closeFn)
    local panel = Card(ScreenGui, UDim2.new(0, w, 0, h), UDim2.new(0.5, -w/2, 0.5, -h/2 + 10), C.Bg, 8, 30)
    panel.Visible = false
    local st = Stroke(panel, C.Border)
    local head = Card(panel, UDim2.new(1, 0, 0, 34), UDim2.new(0, 0, 0, 0), C.TopBar, 0, 31)
    Stroke(head, C.Border)
    Txt(head, titleText, UDim2.new(1, -40, 1, 0), UDim2.new(0, 10, 0, 0), C.Cyan, Enum.Font.GothamBold, Enum.TextXAlignment.Left, 32)
    local closeBtn = Btn(head, "X", UDim2.new(0, 22, 0, 22), UDim2.new(1, -28, 0.5, -11), C.BtnBg, C.TextDim, function() closeFn(panel) end, 32)
    closeBtn.MouseEnter:Connect(function() Tween(closeBtn, {BackgroundColor3 = Color3.fromRGB(200, 45, 55), TextColor3 = C.TextWhite}, 0.12) end)
    closeBtn.MouseLeave:Connect(function() Tween(closeBtn, {BackgroundColor3 = C.BtnBg, TextColor3 = C.TextDim}, 0.12) end)
    return panel
end

local function OpenModalAnimated(p, w, h)
    p.Position = UDim2.new(0.5, -w/2, 0.5, -h/2 + 12)
    p.Visible = true
    Tween(p, {Position = UDim2.new(0.5, -w/2, 0.5, -h/2)}, 0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
end

local function CloseModalAnimated(p, w, h)
    local tw = Tween(p, {Position = UDim2.new(0.5, -w/2, 0.5, -h/2 + 12)}, 0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
    tw.Completed:Connect(function() p.Visible = false end)
end

