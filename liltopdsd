local function AutoRepairJSON(rawText)
    if type(rawText) ~= "string" or (rawText:gsub(" ", ""):gsub("\t", "") == "") then return {}, "{}" end
    local text = rawText:gsub("//[^\r\n]*", ""):gsub("/%*.-%*/", ""):gsub(",%s*}", "}"):gsub(",%s*]", "]")
    local ok, parsed = pcall(function() return HttpService:JSONDecode(text) end)
    if ok and type(parsed) == "table" then return parsed, HttpService:JSONEncode(parsed) end
    local result = {}
    for key, val in text:gmatch('["\']?([%w_%.%-]+)["\']?%s*[:=]%s*(["\']?[%w_%.%-%s]+["\']?)') do
        local cleanKey = key:gsub('["\']', ''):gsub('^%s*(.-)%s*$', '%1')
        local cleanVal = val:gsub('^%s*(.-)%s*$', '%1')
        if cleanVal:sub(1,1) == '"' or cleanVal:sub(1,1) == "'" then cleanVal = cleanVal:sub(2, -2) end
        cleanVal = cleanVal:gsub('^%s*(.-)%s*$', '%1')
        if cleanKey ~= "" then
            local num = tonumber(cleanVal)
            if num ~= nil then result[cleanKey] = num
            elseif cleanVal:lower() == "true" then result[cleanKey] = true
            elseif cleanVal:lower() == "false" then result[cleanKey] = false
            else result[cleanKey] = cleanVal end
        end
    end
    return result, HttpService:JSONEncode(result)
end

