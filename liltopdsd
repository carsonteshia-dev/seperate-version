local function AddEditRow(flagKey, flagVal)
    if type(flagKey) ~= "string" then return end
    local R = Instance.new("Frame")
    R.Size = UDim2.new(1, -8, 0, 30)
    R.BackgroundTransparency = 1
    R.Parent = EditScroll

    local Nm = Instance.new("TextLabel")
    Nm.Size = UDim2.new(0, 160, 1, 0)
    Nm.Position = UDim2.new(0, 6, 0, 0)
    Nm.BackgroundTransparency = 1
    Nm.Text = flagKey
    Nm.Font = Enum.Font.Code
    Nm.TextSize = 11
    Nm.TextColor3 = C.TxtDark
    Nm.TextXAlignment = Enum.TextXAlignment.Left
    Nm.Parent = R

    local ValBox = Instance.new("TextBox")
    ValBox.Size = UDim2.new(0, 70, 1, -6)
    ValBox.Position = UDim2.new(0, 170, 0.5, -12)
    ValBox.BackgroundColor3 = C.CBoxBg
    ValBox.Text = tostring(flagVal)
    ValBox.Font = Enum.Font.Code
    ValBox.TextSize = 11
    ValBox.TextColor3 = C.TxtYellow
    ValBox.Parent = R
    
    local vCorner = Instance.new("UICorner")
    vCorner.CornerRadius = UDim.new(0, 3)
    vCorner.Parent = ValBox

    local vStroke = Instance.new("UIStroke")
    vStroke.Thickness = 1
    vStroke.Color = C.Border
    vStroke.Parent = ValBox

    local Sv = Instance.new("TextButton")
    Sv.Size = UDim2.new(0, 45, 1, -6)
    Sv.Position = UDim2.new(1, -50, 0.5, -12)
    Sv.BackgroundColor3 = C.Red
    Sv.BorderSizePixel = 0
    Sv.Text = "Set"
    Sv.Font = Enum.Font.GothamBold
    Sv.TextSize = 10
    Sv.TextColor3 = C.TxtYellow
    Sv.Parent = R
    
    local svCorner = Instance.new("UICorner")
    svCorner.CornerRadius = UDim.new(0, 3)
    svCorner.Parent = Sv

    local svStroke = Instance.new("UIStroke")
    svStroke.Thickness = 1
    svStroke.Color = C.YellowBorder
    svStroke.Parent = Sv

    Sv.MouseButton1Click:Connect(function()
        local nv = ValBox.Text
        if tonumber(nv) then nv = tonumber(nv)
        elseif nv:lower() == "true" then nv = true
        elseif nv:lower() == "false" then nv = false end
        local cnt = ""
        pcall(function() cnt = readfile(FFLAGS_FILE) end)
        local ok, dec = pcall(function() return HttpService:JSONDecode(cnt) end)
        if ok and type(dec) == "table" then
            dec[flagKey] = nv
            pcall(function() writefile(FFLAGS_FILE, HttpService:JSONEncode(dec)) end)
            if areFlagsApplied() then
                ApplyFlagToEngine(flagKey, nv)
            end
            RefreshList()
        end
    end)
end

local function LoadEditPanel(srch)
    for _, x in ipairs(EditScroll:GetChildren()) do
        if x:IsA("Frame") then x:Destroy() end
    end
    local cnt = ""
    pcall(function() cnt = readfile(FFLAGS_FILE) end)
    if cnt and cnt ~= "" then
        local ok, dec = pcall(function() return HttpService:JSONDecode(cnt) end)
        if ok and type(dec) == "table" then
            for k, v in pairs(dec) do
                if type(k) == "string" and (not srch or srch == "" or string.find(string.lower(k), string.lower(srch), 1, true)) then
                    AddEditRow(k, v)
                end
            end
        end
    end
    EditScroll.CanvasSize = UDim2.new(0, 0, 0, EL.AbsoluteContentSize.Y + 10)
end

SearchBox:GetPropertyChangedSignal("Text"):Connect(function() LoadEditPanel(SearchBox.Text) end)
EL:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
    EditScroll.CanvasSize = UDim2.new(0, 0, 0, EL.AbsoluteContentSize.Y + 10)
end)

