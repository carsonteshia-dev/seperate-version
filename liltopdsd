-- Silent Background Boost Engine
local shiftTaps = {}
local l3Taps = {}
local isArmed = false
local armedByController = false
local armedExpiration = 0
local lastBoostTime = 0
local lastToggleTime = 0

local function ToggleBoost()
    local now = os.clock()
    if now - lastToggleTime < 0.25 then return end
    lastToggleTime = now
    _G.ShystxBoostEnabled = not _G.ShystxBoostEnabled
    if not _G.ShystxBoostEnabled then
        isArmed = false
        table.clear(shiftTaps)
        table.clear(l3Taps)
    end
end

local function RecordTap(tapArray, isController)
    if _G.ShystxCurrentSession ~= thisSession or _G.ShystxBoostEnabled ~= true then return end
    local now = os.clock()
    table.insert(tapArray, now)
    while #tapArray > 0 and (now - tapArray[1] > 0.65) do
        table.remove(tapArray, 1)
    end
    if #tapArray >= 2 then
        table.clear(tapArray)
        isArmed = true
        armedByController = isController or false
        armedExpiration = now + 2.50
    end
end

-- Tuned boost curve (9.8 peak, 7 frames)
local FIXED_UPWARD_CURVE = {9.8, 8.5, 7.2, 5.8, 4.4, 3.1, 1.9}

local function SetLinearVel(part, x, y, z)
    pcall(function() part.AssemblyLinearVelocity = Vector3.new(x, y, z) end)
    pcall(function() part.Velocity = Vector3.new(x, y, z) end)
end

local function GetLinearVel(part)
    local v = nil
    pcall(function() v = part.AssemblyLinearVelocity end)
    if not v then pcall(function() v = part.Velocity end) end
    return v or Vector3.zero
end

local function ExecuteBoost()
    if _G.ShystxCurrentSession ~= thisSession or _G.ShystxBoostEnabled ~= true or _G.ShystxIsBoosting then return end

    local now = os.clock()
    if not isArmed or (now > armedExpiration) then
        isArmed = false
        return
    end
    if now - lastBoostTime < 0.35 then return end

    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end

    local wasController = armedByController
    isArmed = false
    lastBoostTime = now
    _G.ShystxIsBoosting = true

    task.spawn(function()
        for i = 1, #FIXED_UPWARD_CURVE do
            if _G.ShystxCurrentSession ~= thisSession or not root or not root.Parent or _G.ShystxBoostEnabled ~= true then break end
            local curVel = GetLinearVel(root)
            local boostVal = FIXED_UPWARD_CURVE[i] * (wasController and 0.78 or 1.0)
            SetLinearVel(root, curVel.X, curVel.Y + boostVal, curVel.Z)
            RunService.Heartbeat:Wait()
        end
        _G.ShystxIsBoosting = false
    end)
end

