                local valBox = New("TextBox", {Size = UDim2.new(0, 72, 0, 22), Position = UDim2.new(0, 0, 0.5, -11), BackgroundColor3 = C.EditorBg, Text = tostring(v), Font = Enum.Font.Code, TextSize = 11, TextColor3 = C.Blue, ZIndex = 25}, dock, 4)
                New("UIStroke", {Thickness = 1, Color = C.Border}, valBox)

                local setBtn = New("TextButton", {Size = UDim2.new(0, 52, 0, 22), Position = UDim2.new(0, 77, 0.5, -11), BackgroundColor3 = C.Green, BorderSizePixel = 0, Text = "SET", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.TxtWhite, ZIndex = 25}, dock, 4)
                local delBtn = New("TextButton", {Size = UDim2.new(0, 52, 0, 22), Position = UDim2.new(0, 134, 0.5, -11), BackgroundColor3 = C.Red, BorderSizePixel = 0, Text = "DEL", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.TxtWhite, ZIndex = 25}, dock, 4)

                local function ApplyVal()
                    local newText = valBox.Text:gsub('^%s*(.-)%s*$', '%1')
                    local parsedVal = tonumber(newText)
                    if parsedVal == nil then
                        if newText:lower() == "true" then parsedVal = true
                        elseif newText:lower() == "false" then parsedVal = false
                        else parsedVal = newText end
                    end
                    dec[k] = parsedVal
                    SafeWriteFile(F_PATH, HttpService:JSONEncode(dec))
                    TrySetFlag(k, parsedVal)
                    return parsedVal
                end

                valBox.FocusLost:Connect(function() ApplyVal() RefreshLists() end)

                setBtn.MouseButton1Click:Connect(function()
                    local finalVal = ApplyVal()
                    setBtn.Text = "OK!"
                    ShowToast("Set " .. k .. " = " .. tostring(finalVal), C.Green)
                    task.delay(0.9, function() pcall(function() setBtn.Text = "SET" end) end)
                    RefreshLists()
                end)

                delBtn.MouseButton1Click:Connect(function()
                    dec[k] = nil
                    SafeWriteFile(F_PATH, HttpService:JSONEncode(dec))
                    row:Destroy()
                    ShowToast("Deleted " .. k, C.Red)
                    RefreshLists()
                end)
            end
        end
    end
    EditScroll.CanvasSize = UDim2.new(0, 0, 0, ELayout.AbsoluteContentSize.Y + 12)
end

