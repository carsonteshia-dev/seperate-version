-- Jump Boost Logic (Runs only when _G.ShystxFlagsApplied == true)
local isArmed, armedExpiration, lastBoostTime = true, math.huge, 0
local function ToggleBoost()
    if _G.ShystxFlagsApplied ~= true then return end
    _G.ShystxBoostEnabled = not _G.ShystxBoostEnabled
    if not _G.ShystxBoostEnabled then isArmed = false end
end

TrackConn(UserInputService.InputBegan:Connect(function(inp, gpe)
    if inp.KeyCode == Enum.KeyCode.DPadUp then
        ToggleBoost()
    elseif not gpe and (inp.KeyCode == Enum.KeyCode.LeftControl or inp.KeyCode == Enum.KeyCode.RightControl) then
        ToggleBoost()
    end
end))

-- Tuned downward further for balanced, natural jump trajectory
local SMOOTH_UPWARD_CURVE = {7.8, 6.5, 5.3, 4.1, 2.9, 1.8, 0.8}
local function ExecuteBoost()
    if _G.ShystxCurrentSession ~= thisSession or _G.ShystxBoostEnabled ~= true or _G.ShystxFlagsApplied ~= true or _G.ShystxIsBoosting then return end
    local now = os.clock()
    if not isArmed or (now > armedExpiration) then isArmed = false; return end
    if now - lastBoostTime < 0.35 then return end
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("Torso")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum then return end
    isArmed = false
    lastBoostTime = now
    _G.ShystxIsBoosting = true
    task.spawn(function()
        for i = 1, #SMOOTH_UPWARD_CURVE do
            if _G.ShystxCurrentSession ~= thisSession or not root or not root.Parent or _G.ShystxBoostEnabled ~= true or _G.ShystxFlagsApplied ~= true then break end
            local cur = root.AssemblyLinearVelocity or root.Velocity or Vector3.zero
            local bVal = SMOOTH_UPWARD_CURVE[i]
            pcall(function() root.AssemblyLinearVelocity = Vector3.new(cur.X, cur.Y + bVal, cur.Z) end)
            pcall(function() root.Velocity = Vector3.new(cur.X, cur.Y + bVal, cur.Z) end)
            RunService.Heartbeat:Wait()
        end
        _G.ShystxIsBoosting = false
    end)
end

local function TryTriggerBoost()
    if isArmed and _G.ShystxBoostEnabled == true and _G.ShystxFlagsApplied == true then
        ExecuteBoost()
    end
end

local charConns = {}
local function setupCharacter(char)
    if not char or _G.ShystxCurrentSession ~= thisSession then return end
    for _, c in ipairs(charConns) do if c and c.Disconnect then c:Disconnect() end end
    charConns = {}
    local hum = char:WaitForChild("Humanoid", 5)
    if not hum then return end
    local sc = hum.StateChanged:Connect(function(_, st)
        if (st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall) then
            TryTriggerBoost()
        elseif (st == Enum.HumanoidStateType.Landed or st == Enum.HumanoidStateType.Running) then
            isArmed = true
            _G.ShystxIsBoosting = false
        end
    end)
    table.insert(charConns, sc); TrackConn(sc)
    local jc = hum.Jumping:Connect(function(act)
        if act then TryTriggerBoost() end
    end)
    table.insert(charConns, jc); TrackConn(jc)
end

TrackConn(UserInputService.JumpRequest:Connect(TryTriggerBoost))

-- === Pre-Render Cached Sanitizer (Controller, Mobile & Keyboard Zero Flicker) ===
local cachedLabels = {}
local registeredLabels = {}

local function isTargetToken(token)
    if type(token) ~= "string" then return false end
    local t = token:gsub("^%s+", ""):gsub("%s+$", ""):lower()
    if t == "" or t == "[ none ]" or t == "none" or t == "[none]" then return true end

    -- Control variants
    if t:find("leftcontrol", 1, true) or t:find("left control", 1, true)
        or t:find("left_control", 1, true) or t:find("left-control", 1, true)
        or t:find("leftctrl", 1, true) or t:find("left ctrl", 1, true)
        or t:find("left_ctrl", 1, true) or t:find("left-ctrl", 1, true)
        or t:find("lctrl", 1, true) or t:find("l-ctrl", 1, true)
        or t:find("rightcontrol", 1, true) or t:find("right control", 1, true)
        or t:find("right_control", 1, true) or t:find("right-control", 1, true)
        or t:find("rightctrl", 1, true) or t:find("right ctrl", 1, true)
        or t:find("right_ctrl", 1, true) or t:find("right-ctrl", 1, true)
        or t:find("rctrl", 1, true) or t:find("r-ctrl", 1, true)
    then
        return true
    end

    if (t:find("control", 1, true) or t:find("ctrl", 1, true)) and (t:find("left", 1, true) or t:find("right", 1, true)) then
        return true
    end

    -- DPad / Gamepad variants
    if t:find("dpadup", 1, true) or t:find("dpad up", 1, true)
        or t:find("d-pad up", 1, true) or t:find("d_pad up", 1, true)
        or t:find("dpad_up", 1, true) or t:find("d-pad_up", 1, true)
        or t:find("dpad-up", 1, true) or t:find("d-pad-up", 1, true)
        or t:find("up dpad", 1, true) or t:find("up d-pad", 1, true)
        or t:find("up d_pad", 1, true)
    then
        return true
    end

    if (t:find("dpad", 1, true) or t:find("d-pad", 1, true)) and t:find("up", 1, true) then
        return true
    end

    if (t:find("gamepad", 1, true) or t:find("controller", 1, true)) and (t:find("up", 1, true) or t:find("dpad", 1, true)) then
        return true
    end

    return false
end

local function sanitizeText(text)
    if type(text) ~= "string" or text == "" or text == "ACTIVE INPUT MONITOR" or text == "Keys Pressed" then
        return ""
    end

    local tTrim = text:gsub("^%s+", ""):gsub("%s+$", "")
    local tLow = tTrim:lower()
    if tLow == "[ none ]" or tLow == "none" or tLow == "[none]" or tLow == "nil" or tLow == "[ nil ]" then
        return ""
    end

    local hasTarget = false
    if tLow:find("control", 1, true) or tLow:find("ctrl", 1, true) or tLow:find("dpad", 1, true) or tLow:find("d-pad", 1, true) then
        hasTarget = true
    elseif (tLow:find("gamepad", 1, true) or tLow:find("controller", 1, true) or tLow:find("touch", 1, true) or tLow:find("button", 1, true)) and (tLow:find("up", 1, true) or tLow:find("ctrl", 1, true) or tLow:find("control", 1, true)) then
        hasTarget = true
    end

    if not hasTarget then
        return text
    end

    -- Detect delimiter
    local delim = "  +  "
    local splitPattern = "[^%+]+"
    if text:find("%+", 1, true) then
        splitPattern = "[^%+]+"
        delim = text:find("  %+  ") and "  +  " or " + "
    elseif text:find(",", 1, true) then
        splitPattern = "[^,]+"
        delim = text:find(", ") and ", " or ","
    elseif text:find("\n", 1, true) then
        splitPattern = "[^\n]+"
        delim = "\n"
    end

    local clean = {}
    for part in text:gmatch(splitPattern) do
        local pTrim = part:gsub("^%s+", ""):gsub("%s+$", "")
        if not isTargetToken(pTrim) and pTrim ~= "" then
            table.insert(clean, pTrim)
        end
    end

    if #clean == 0 then
        return ""
    else
        return table.concat(clean, delim)
    end
end

local function addLabel(obj)
    if not obj or registeredLabels[obj] then return end
    local isTxt = false
    pcall(function()
        if obj:IsA("TextLabel") or obj:IsA("TextButton") or obj:IsA("TextBox") then
            isTxt = true
        end
    end)
    if not isTxt then return end
    if obj.Text == "ACTIVE INPUT MONITOR" or obj.Text == "Keys Pressed" then return end

    registeredLabels[obj] = true
    table.insert(cachedLabels, obj)

    obj:GetPropertyChangedSignal("Text"):Connect(function()
        local cur = obj.Text
        local cleaned = sanitizeText(cur)
        if cur ~= cleaned then obj.Text = cleaned end
    end)

    local cur = obj.Text
    local cleaned = sanitizeText(cur)
    if cur ~= cleaned then obj.Text = cleaned end
end

local function safeScan(container)
    if not container then return end
    pcall(function()
        local descs = container:GetDescendants()
        if type(descs) == "table" then
            for _, d in ipairs(descs) do addLabel(d) end
        end
    end)
    pcall(function()
        local children = container:GetChildren()
        if type(children) == "table" then
            for _, c in ipairs(children) do addLabel(c) end
        end
    end)
    pcall(function()
        container.DescendantAdded:Connect(addLabel)
    end)
    pcall(function()
        container.ChildAdded:Connect(addLabel)
    end)
end

