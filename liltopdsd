    local function IsSuppressed(msg)
        if type(msg) ~= "string" then return false end
        local m = msg:lower()
        return m:find("locales.en-us", 1, true) ~= nil
            or m:find("expected ')'", 1, true) ~= nil
            or m:find("missing argument", 1, true) ~= nil
            or m:find("modules.common.locales", 1, true) ~= nil
            or m:find("script 'coregui", 1, true) ~= nil
            or m:find("coregui.5824", 1, true) ~= nil
            or m:find("coregui.26628", 1, true) ~= nil
    end

    local function FilterHistory(hist)
        if type(hist) ~= "table" then return hist end
        local clean = {}
        local skipStack = false
        for _, item in ipairs(hist) do
            local msg = ""
            if type(item) == "table" then
                msg = tostring(item.message or item.Message or "")
            else
                msg = tostring(item)
            end
            if IsSuppressed(msg) then
                skipStack = true
            elseif skipStack then
                local mLow = msg:lower()
                if mLow:find("stack begin", 1, true) or mLow:find("line 1", 1, true) or mLow:find("script 'coregui", 1, true) or mLow:find("stack end", 1, true) then
                    if mLow:find("stack end", 1, true) then skipStack = false end
                else
                    skipStack = false
                    table.insert(clean, item)
                end
            else
                table.insert(clean, item)
            end
        end
        return clean
    end

    if typeof(hookfunction) == "function" then
        local oldGetLog
        oldGetLog = hookfunction(LogService.GetLogHistory, function(self, ...)
            return FilterHistory(oldGetLog(self, ...))
        end)
    end

    if typeof(hookmetamethod) == "function" then
        local oldNm
        oldNm = hookmetamethod(game, "__namecall", function(self, ...)
            local method = getnamecallmethod and getnamecallmethod()
            if method == "GetLogHistory" and self == LogService then
                return FilterHistory(oldNm(self, ...))
            end
            return oldNm(self, ...)
        end)
    end

    LogService.MessageOut:Connect(function(msg, msgType)
        -- silences localized missing argument logging
    end)

    local function CleanConsoleUI()
        pcall(function()
            local devConsole = CoreGui:FindFirstChild("DevConsoleMaster") or CoreGui:FindFirstChild("DeveloperConsole")
            if not devConsole then return end
            
            local isStackActive = false
            local toPurge = {}
            
            for _, desc in ipairs(devConsole:GetDescendants()) do
                if desc:IsA("TextLabel") or desc:IsA("TextBox") then
                    local txt = desc.Text or ""
                    if IsSuppressed(txt) then
                        isStackActive = true
                        local frame = desc:FindFirstAncestorOfClass("Frame") or desc
                        toPurge[frame] = true
                    elseif isStackActive then
                        local tLow = txt:lower()
                        if tLow:find("stack begin", 1, true) or tLow:find("line 1", 1, true) or tLow:find("script 'coregui", 1, true) or tLow:find("stack end", 1, true) then
