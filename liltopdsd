local function PopulateEditList(query)
    for _, x in ipairs(EditScroll:GetChildren()) do if x:IsA("Frame") then x:Destroy() end end
    local cnt = SafeReadFile(F_PATH)
    local dec = AutoRepairJSON(cnt)
    local filter = (query or ""):lower():gsub(" ", "")
    if type(dec) == "table" then
        for k, v in pairs(dec) do
            if filter == "" or k:lower():find(filter, 1, true) then
                local row = New("Frame", {Size = UDim2.new(1, -8, 0, 30), BackgroundColor3 = C.CBoxBg, BorderSizePixel = 0, ZIndex = 11}, EditScroll, 6)
                New("TextLabel", {Size = UDim2.new(1, -165, 1, 0), Position = UDim2.new(0, 10, 0, 0), BackgroundTransparency = 1, Text = k, Font = Enum.Font.Code, TextSize = 11, TextColor3 = C.TxtDark, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 11}, row)
                local valBox = New("TextBox", {Size = UDim2.new(0, 80, 0, 22), Position = UDim2.new(1, -150, 0.5, -11), BackgroundColor3 = C.EditorBg, Text = tostring(v), Font = Enum.Font.Code, TextSize = 11, TextColor3 = C.Blue, ZIndex = 11}, row, 4)
                valBox.FocusLost:Connect(function()
                    local newText = valBox.Text:gsub('^%s*(.-)%s*$', '%1')
                    local num = tonumber(newText)
                    if num ~= nil then dec[k] = num
                    elseif newText:lower() == "true" then dec[k] = true
                    elseif newText:lower() == "false" then dec[k] = false
                    else dec[k] = newText end
                    SafeWriteFile(F_PATH, HttpService:JSONEncode(dec))
                    RefreshLists()
                end)
                local del = New("TextButton", {Size = UDim2.new(0, 50, 0, 22), Position = UDim2.new(1, -60, 0.5, -11), BackgroundColor3 = C.BtnBg, BorderSizePixel = 0, Text = "Delete", Font = Enum.Font.GothamMedium, TextSize = 10, TextColor3 = C.Red, ZIndex = 11}, row, 4)
                del.MouseButton1Click:Connect(function()
                    dec[k] = nil
                    SafeWriteFile(F_PATH, HttpService:JSONEncode(dec))
                    row:Destroy()
                    RefreshLists()
                end)
            end
        end
    end
    EditScroll.CanvasSize = UDim2.new(0, 0, 0, ELayout.AbsoluteContentSize.Y + 10)
end

