local isSanitizing = false
local function SafeCollapse(inst)
    pcall(function()
        inst.Visible = false
        if inst:IsA("TextLabel") or inst:IsA("TextBox") or inst:IsA("TextButton") then
            inst.Text = ""
            inst.TextTransparency = 1
        end
        inst.BackgroundTransparency = 1
        inst.Size = UDim2.new(0, 0, 0, 0)
        local p = inst.Parent
        if p and p:IsA("GuiObject") and p.Name ~= "ClientLog" and not p:IsA("ScreenGui") and not p:IsA("ScrollingFrame") then
            p.Visible = false
            p.BackgroundTransparency = 1
            p.Size = UDim2.new(0, 0, 0, 0)
        end
    end)
end

local function AttachWatcher(inst)
    if not (inst:IsA("TextLabel") or inst:IsA("TextBox") or inst:IsA("TextButton")) then return end
    local function Validate()
        if isSanitizing or _G.ShystxCurrentSession ~= thisSession then return end
        pcall(function()
            local t = inst.Text
            if t and HasTargetOnly(t) then
                isSanitizing = true
                local cleaned = StripTargetLines(t)
                if cleaned == "" or (cleaned:gsub(" ", ""):gsub("\t", "") == "") then
                    SafeCollapse(inst)
                else
                    inst.Text = cleaned
                end
                isSanitizing = false
            end
        end)
    end
    Validate()
    pcall(function()
        TrackConn(inst:GetPropertyChangedSignal("Text"):Connect(Validate))
    end)
end

local function HookContainer(c)
    if not c then return end
    pcall(function()
        for _, item in ipairs(c:GetDescendants()) do AttachWatcher(item) end
        TrackConn(c.DescendantAdded:Connect(AttachWatcher))
    end)
end

