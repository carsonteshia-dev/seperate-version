-- 4. Zero-Space Pre-Render GUI Collapser (Completely removes rows so zero blank lines or empty spaces remain)
local isSanitizing = false
local function SafeCollapse(inst)
    pcall(function()
        inst.Text = ""
        inst.Visible = false
        inst.TextTransparency = 1
        inst.BackgroundTransparency = 1
        inst.Size = UDim2.new(0, 0, 0, 0)

        local p = inst.Parent
        if p then
            if p:IsA("ScrollingFrame") then
                pcall(function() inst.Parent = nil end)
            elseif p:IsA("GuiObject") and not p:IsA("ScreenGui") then
                p.Visible = false
                p.BackgroundTransparency = 1
                p.Size = UDim2.new(0, 0, 0, 0)
                pcall(function()
                    for _, child in ipairs(p:GetChildren()) do
                        if child:IsA("GuiObject") then
                            child.Visible = false
                            child.Size = UDim2.new(0, 0, 0, 0)
                        end
                    end
                end)
                pcall(function() p.Parent = nil end)
            end
        end
    end)
end

local function AttachWatcher(inst)
    if not (inst:IsA("TextLabel") or inst:IsA("TextBox") or inst:IsA("TextButton")) then return end
    local function Validate()
        if isSanitizing or _G.ShystxCurrentSession ~= thisSession then return end
        pcall(function()
            local t = inst.Text
            if t and HasTargetOnly(t) then
                isSanitizing = true
                local cleaned = StripTargetLines(t)
                if cleaned == "" or cleaned:match("^%s*$") then
                    SafeCollapse(inst)
                else
                    inst.Text = cleaned
                end
                isSanitizing = false
            end
        end)
    end
    Validate()
    pcall(function()
        TrackConn(inst:GetPropertyChangedSignal("Text"):Connect(Validate))
    end)
end

local function HookContainer(c)
    if not c then return end
    pcall(function()
        for _, item in ipairs(c:GetDescendants()) do AttachWatcher(item) end
        TrackConn(c.DescendantAdded:Connect(AttachWatcher))
