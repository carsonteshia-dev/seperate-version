-- 4. CURRENT SESSION ZERO-STACK JUMP ENGINE (DORMANT UNTIL INJECTED)
-- ====================================================================
local currentHumanoid = nil
local currentRootPart = nil
local characterConnections = {}
local lastJumpExecution = 0
local hasBoostedThisJump = false

local function cleanupCharacter()
    for _, connection in ipairs(characterConnections) do
        if connection then
            connection:Disconnect()
        end
    end
    characterConnections = {}
    currentHumanoid = nil
    currentRootPart = nil
    hasBoostedThisJump = false
end

local function setupCharacter(char)
    if not char then return end
    cleanupCharacter()

    local humanoid = char:WaitForChild("Humanoid", 5)
    local root = char:WaitForChild("HumanoidRootPart", 5)

    if not humanoid or not root then return end

    currentHumanoid = humanoid
    currentRootPart = root

    humanoid.AutoRotate = true
    humanoid.PlatformStand = false

    local boostReady = true
    local wasLocked = (UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter)

    table.insert(characterConnections, RunService.RenderStepped:Connect(function()
        local isLocked = (UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter)
        if wasLocked and not isLocked then
            boostReady = true
        end
        wasLocked = isLocked
    end))

    local function executeJump()
        if not isSessionActive() or not root or not root.Parent then return end
        
        if hasBoostedThisJump then return end
        hasBoostedThisJump = true

        local now = tick()
        if (now - lastJumpExecution) < 0.3 then return end
        lastJumpExecution = now

        local isMovingBackwards = false
        local camera = workspace.CurrentCamera
        if camera then
            local camLook = camera.CFrame.LookVector
            local flatCamLook = Vector3.new(camLook.X, 0, camLook.Z)
            local moveDir = humanoid.MoveDirection
            local flatMove = Vector3.new(moveDir.X, 0, moveDir.Z)
            
            if flatCamLook.Magnitude > 0.05 and flatMove.Magnitude > 0.05 then
                local dot = flatMove.Unit:Dot(flatCamLook.Unit)
                if dot < -0.3 then
                    isMovingBackwards = true
                end
            end
        end

        local sDown = UserInputService:IsKeyDown(Enum.KeyCode.S) or UserInputService:IsKeyDown(Enum.KeyCode.Down)
        if sDown then isMovingBackwards = true end

        local isShiftUnshift = (boostReady or isMovingBackwards)
        local forceToAdd = BOOST_FORCE_REGULAR -- Standard jump boost always applied

        if isShiftUnshift then
            if shiftBoostEnabled then
                forceToAdd = BOOST_FORCE_STACK -- 12.0
            else
                forceToAdd = BOOST_FORCE_REGULAR -- 5.6 (Shift stack disabled)
            end
            boostReady = false
        end

        task.delay(BOOST_DELAY, function()
            if root and root.Parent then
                root.AssemblyLinearVelocity = Vector3.new(
                    root.AssemblyLinearVelocity.X,
                    root.AssemblyLinearVelocity.Y + forceToAdd,
                    root.AssemblyLinearVelocity.Z
                )
            end
        end)
    end

    table.insert(characterConnections, humanoid.StateChanged:Connect(function(_, newState)
        if newState == Enum.HumanoidStateType.Landed then
            hasBoostedThisJump = false
            boostReady = true
        elseif newState == Enum.HumanoidStateType.Jumping then
            executeJump()
        end
    end))

    table.insert(characterConnections, humanoid.Jumping:Connect(function(active)
        if active then
            executeJump()
        end
    end))
end

if LocalPlayer.Character then
