-- Animated Button with Interactive Hover & Press Tweens
local function Btn(parent, text, size, pos, bg, col, fn, z)
    local b = Instance.new("TextButton", parent)
    b.Size = size or UDim2.new(0, 80, 0, 30)
    b.Position = pos or UDim2.new(0, 0, 0, 0)
    b.BackgroundColor3 = bg or C.BtnBg
    b.Text = text or ""
    b.TextColor3 = col or C.TextWhite
    b.Font = Enum.Font.GothamBold
    b.TextSize = 10
    b.BorderSizePixel = 0
    b.AutoButtonColor = false
    b.ZIndex = z or 12
    Instance.new("UICorner", b).CornerRadius = UDim.new(0, 4)
    local st = Stroke(b, bg == C.Cyan and C.Cyan or C.Border)
    
    local isPrimary = (bg == C.Cyan)
    local isDanger = (col == C.Red)
    local defBg = bg or C.BtnBg
    local hovBg = isPrimary and C.CyanHover or (isDanger and Color3.fromRGB(45, 24, 28) or C.BtnHover)
    local hovStroke = isPrimary and Color3.fromRGB(120, 245, 255) or (isDanger and C.RedHover or C.BorderHover)

    b.MouseEnter:Connect(function()
        Tween(b, {BackgroundColor3 = hovBg}, 0.12)
        Tween(st, {Color = hovStroke}, 0.12)
    end)
    b.MouseLeave:Connect(function()
        Tween(b, {BackgroundColor3 = defBg}, 0.12)
        Tween(st, {Color = isPrimary and C.Cyan or C.Border}, 0.12)
    end)
    b.MouseButton1Down:Connect(function()
        Tween(b, {Size = UDim2.new(size.X.Scale, size.X.Offset - 2, size.Y.Scale, size.Y.Offset - 2)}, 0.08)
    end)
    b.MouseButton1Up:Connect(function()
        Tween(b, {Size = size}, 0.08)
    end)

    if fn then OnClick(b, fn) end
    return b
end

