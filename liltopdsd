InjectBtn.MouseButton1Click:Connect(function()
    local decoded = AutoRepairJSON(SafeReadFile(F_PATH))
    local count = 0
    if type(decoded) == "table" then
        for _ in pairs(decoded) do count = count + 1 end
    end
    SafeWriteFile(F_PATH, HttpService:JSONEncode(decoded))

