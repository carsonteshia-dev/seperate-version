-- Ultra-Responsive Click Handler with Debounce Lock
local function OnClick(btn, fn)
    local debounce = false
    local function trigger()
        if debounce then return end
        debounce = true
        task.spawn(function()
            pcall(fn)
            task.wait(0.12)
            debounce = false
        end)
    end
    btn.MouseButton1Click:Connect(trigger)
    btn.MouseButton1Down:Connect(trigger)
    if btn.Activated then btn.Activated:Connect(trigger) end
end

local function Card(parent, size, pos, bg, corner, z)
    local f = Instance.new("Frame", parent)
    f.Size = size or UDim2.new(1, 0, 1, 0)
