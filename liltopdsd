        end
    end
    ImportPanel.Visible = false
end)
ImpReplace.MouseButton1Click:Connect(function()
    if ImpBox.Text ~= "" then
        local newFlags = AutoRepairJSON(ImpBox.Text)
        if type(newFlags) == "table" then
            local rCount = 0
            for _ in pairs(newFlags) do rCount = rCount + 1 end
            SafeWriteFile(F_PATH, HttpService:JSONEncode(newFlags))
            ShowToast("Replaced active list with " .. tostring(rCount) .. " flags", C.Red)
            RefreshLists()
        end
    end
    ImportPanel.Visible = false
end)

