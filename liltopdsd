                loadBtn.MouseLeave:Connect(function() Tween(loadBtn, {BackgroundColor3 = C.Blue}, 0.15) end)
                delBtn.MouseEnter:Connect(function() Tween(delBtn, {BackgroundColor3 = C.DarkRed}, 0.15) end)
                delBtn.MouseLeave:Connect(function() Tween(delBtn, {BackgroundColor3 = C.Red}, 0.15) end)

                loadBtn.MouseButton1Click:Connect(function()
                    SafeWriteFile(F_PATH, HttpService:JSONEncode(flagsObj))
                    ShowToast("Loaded config: " .. cfgName, C.Blue)
                    RefreshLists()
                end)

                delBtn.MouseButton1Click:Connect(function()
                    savedConfigs[cfgName] = nil
                    _G.ShystxSavedConfigs[cfgName] = nil
                    SafeWriteFile(CONFIGS_PATH, HttpService:JSONEncode(savedConfigs))
                    row:Destroy()
                    ShowToast("Deleted config: " .. cfgName, C.Red)
                    RefreshLists()
                end)
            end
        end
    end
    TabSavedBtn.Text = "Named Configs (" .. tostring(cfgTotal) .. ")"

    FlagScroll.CanvasSize = UDim2.new(0, 0, 0, FLayout.AbsoluteContentSize.Y + 12)
    ConfigScroll.CanvasSize = UDim2.new(0, 0, 0, CLayout.AbsoluteContentSize.Y + 12)
end

