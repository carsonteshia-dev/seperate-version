local function AutoRepairJSON(raw)
    if not raw or raw == "" then return {} end
    local ok, res = pcall(function() return HttpService:JSONDecode(raw) end)
    if ok and type(res) == "table" then return res end
    local dict = {}
    for line in raw:gmatch("[^\r\n]+") do
        local rawK, rawV = line:match("([^:=%s]+)%s*[:=]%s*(.+)")
        if rawK and rawV then
            local k = rawK:gsub('^"', ""):gsub("^'", ""):gsub('"$', ""):gsub("'$", "")
            local v = rawV:gsub('^"', ""):gsub("^'", ""):gsub('"$', ""):gsub("'$", ""):gsub(",$", "")
            local low = v:lower()
            if low == "true" then dict[k] = true
            elseif low == "false" then dict[k] = false
            elseif tonumber(v) then dict[k] = tonumber(v)
            else dict[k] = v end
        end
    end
    return dict
end

local function CleanFlagName(str)
    if type(str) ~= "string" then return "" end
    return str:gsub("^DFInt", ""):gsub("^DFFlag", ""):gsub("^FFlag", ""):gsub("^FInt", ""):gsub("^DFString", ""):gsub("^FString", ""):gsub("^FBool", "")
end

local function TrySetFlag(f, v)
    if type(f) ~= "string" then return false end
    local clean = CleanFlagName(f)
    local num = tonumber(v)
    local str = tostring(v)
    local bool = nil
    local low = str:lower()
    if low == "true" then bool = true
    elseif low == "false" then bool = false end

    if (f:find("TaskSchedulerTargetFps") or clean:find("TaskSchedulerTargetFps")) and num and type(rawSetFpsCap) == "function" then
        pcall(function() rawSetFpsCap(num) end)
    end

    local candidates = {f, clean, "FFlag" .. clean, "DFInt" .. clean, "FInt" .. clean, "DFFlag" .. clean}
    local success = false

    local function callSetter(fn, name, val)
        local ok = pcall(fn, name, val)
        if ok then success = true end
        return ok
    end

    -- 1. Exploit setfflag API
    if type(rawSetFFlag) == "function" then
        for _, name in ipairs(candidates) do
            if bool ~= nil then
                callSetter(rawSetFFlag, name, bool)
                callSetter(rawSetFFlag, name, bool and "True" or "False")
                callSetter(rawSetFFlag, name, bool and "true" or "false")
            elseif num ~= nil then
                callSetter(rawSetFFlag, name, num)
                callSetter(rawSetFFlag, name, str)
            else
                callSetter(rawSetFFlag, name, str)
            end
        end
    end

    -- 2. Engine settings():SetFFlag
    pcall(function()
        if settings and typeof(settings) == "function" then
            local s = settings()
            if s and type(s.SetFFlag) == "function" then
                for _, name in ipairs(candidates) do
                    callSetter(function(n, val) s:SetFFlag(n, tostring(val)) end, name, v)
                end
            end
        end
    end)

    -- 3. Engine game:SetFFlag
    pcall(function()
        if game and type(game.SetFFlag) == "function" then
            for _, name in ipairs(candidates) do
                callSetter(function(n, val) game:SetFFlag(n, tostring(val)) end, name, v)
            end
        end
    end)

    return success
end

local function IsHiddenFlag(flagName)
    if type(flagName) ~= "string" then return false end
    local clean = CleanFlagName(flagName):lower()
    return clean:find("fluid", 1, true) ~= nil or clean:find("hipheight", 1, true) ~= nil
end

