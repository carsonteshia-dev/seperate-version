                    TextXAlignment = Enum.TextXAlignment.Left,
                    ClipsDescendants = true,
                    TextTruncate = Enum.TextTruncate.AtEnd,
                    ZIndex = 7
                }, row)

                -- High Contrast SET & DEL Buttons
                local dock = New("Frame", {Size = UDim2.new(0, 130, 1, 0), Position = UDim2.new(1, -134, 0, 0), BackgroundTransparency = 1, ZIndex = 7}, row)
                local setBtn = New("TextButton", {Size = UDim2.new(0, 60, 0, 24), Position = UDim2.new(0, 0, 0.5, -12), BackgroundColor3 = C.Green, BorderSizePixel = 0, Text = "SET", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.TxtWhite, ZIndex = 8}, dock, 4)
                local delBtn = New("TextButton", {Size = UDim2.new(0, 60, 0, 24), Position = UDim2.new(0, 66, 0.5, -12), BackgroundColor3 = C.Red, BorderSizePixel = 0, Text = "DEL", Font = Enum.Font.GothamBold, TextSize = 10, TextColor3 = C.TxtWhite, ZIndex = 8}, dock, 4)

                setBtn.MouseEnter:Connect(function() Tween(setBtn, {BackgroundColor3 = C.DarkGreen}, 0.15) end)
                setBtn.MouseLeave:Connect(function() Tween(setBtn, {BackgroundColor3 = C.Green}, 0.15) end)
                delBtn.MouseEnter:Connect(function() Tween(delBtn, {BackgroundColor3 = C.DarkRed}, 0.15) end)
                delBtn.MouseLeave:Connect(function() Tween(delBtn, {BackgroundColor3 = C.Red}, 0.15) end)

                setBtn.MouseButton1Click:Connect(function()
                    TrySetFlag(k, v)
                    setBtn.Text = "OK!"
                    setBtn.BackgroundColor3 = C.DarkGreen
                    ShowToast("Applied " .. k, C.Green)
                    task.delay(0.9, function()
                        pcall(function()
                            setBtn.Text = "SET"
                            setBtn.BackgroundColor3 = C.Green
