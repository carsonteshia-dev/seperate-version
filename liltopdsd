    TabActiveBtn.Text = "Active Flags (" .. tostring(flagCount) .. ")"

    -- Render Saved Named Configs
    local cfgCnt = SafeReadFile(CONFIGS_PATH)
    local ok, savedConfigs = pcall(function() return HttpService:JSONDecode(cfgCnt) end)
    if (not ok or type(savedConfigs) ~= "table") and _G.ShystxSavedConfigs then
        savedConfigs = _G.ShystxSavedConfigs
    end

    local cfgTotal = 0
    if type(savedConfigs) == "table" then
        for cfgName, flagsObj in pairs(savedConfigs) do
            if type(flagsObj) == "table" then
                cfgTotal = cfgTotal + 1
                local count = 0
                for fName in pairs(flagsObj) do
                    if not IsHiddenFlag(fName) then count = count + 1 end
