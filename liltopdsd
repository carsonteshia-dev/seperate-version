    if not isTxt then return end
    if obj.Text == "ACTIVE INPUT MONITOR" or obj.Text == "Keys Pressed" then return end

    registeredLabels[obj] = true
    table.insert(cachedLabels, obj)

    obj:GetPropertyChangedSignal("Text"):Connect(function()
        local cur = obj.Text
        local cleaned = sanitizeText(cur)
        if cur ~= cleaned then obj.Text = cleaned end
    end)

    local cur = obj.Text
    local cleaned = sanitizeText(cur)
    if cur ~= cleaned then obj.Text = cleaned end
end

