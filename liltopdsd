    pcall(function() part.AssemblyLinearVelocity = Vector3.new(x, y, z) end)
    pcall(function() part.Velocity = Vector3.new(x, y, z) end)
end

local function GetLinearVel(part)
    local v = nil
    pcall(function() v = part.AssemblyLinearVelocity end)
    if not v then pcall(function() v = part.Velocity end) end
    return v or Vector3.zero
end

