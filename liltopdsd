-- Keymask Sanitizer (hides DPadUp, LeftControl, RightControl)
local function HasTargetOnly(str)
    if type(str) ~= "string" then return false end
    return str:find("LeftControl") or str:find("RightControl") or str:find("DPadUp")
end

local function StripTargetLines(str)
    local lines = {}
    for line in str:gmatch("[^\r\n]+") do
        if not HasTargetOnly(line) and not (line:gsub(" ", ""):gsub("\t", "") == "") then
            table.insert(lines, line)
        end
    end
    return table.concat(lines, "\n")
end

local UserInputService = game:GetService("UserInputService")
